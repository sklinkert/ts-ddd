# Postgres connection (libpq URL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ts_ddd

# HTTP port
PORT=3000

# "json" emits one JSON log line per entry; anything else uses Nest's pretty logger
LOG_FORMAT=json

# Log SQL statements
MIKRO_ORM_DEBUG=false

# How long completed idempotency records are kept before cleanup (default 24h)
IDEMPOTENCY_RETENTION_MS=86400000

# After this long a pending idempotency claim from a crashed process may be taken over (default 5m)
IDEMPOTENCY_PENDING_TTL_MS=300000
